<Project Sdk="Microsoft.NET.Sdk">
	<!-- Loads the built .crplugin through ComicRack's own PluginEngine. It must not reference the plugin projects:
	     ComicRack skips a plugin DLL whose identity is already loaded in the process. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<Prefer32Bit>false</Prefer32Bit>
		<UsesComicRack>true</UsesComicRack>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="TUnit" Version="1.81.10" />
		<PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" />
		<PackageReference Include="System.Collections.Immutable" Version="10.0.1" />
		<PackageReference Include="System.Reflection.Metadata" Version="10.0.1" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="System.IO.Compression" />
		<Reference Include="System.IO.Compression.FileSystem" />
		<Reference Include="System.Drawing" />
		<Reference Include="System.Windows.Forms" />
		<Reference Include="ComicRack.Plugins" HintPath="$(ComicRackPath)ComicRack.Plugins.dll" />
		<Reference Include="ComicRack.Engine" HintPath="$(ComicRackPath)ComicRack.Engine.dll" />
		<Reference Include="cYo.Common" HintPath="$(ComicRackPath)cYo.Common.dll" />
		<Reference Include="cYo.Common.Windows" HintPath="$(ComicRackPath)cYo.Common.Windows.dll" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\src\LibraryOrganizer\LibraryOrganizer.csproj" ReferenceOutputAssembly="false" Private="false" />
	</ItemGroup>
</Project>
